---
import { Image } from 'astro:assets';
import { imageAsset } from '../lib/images';

interface Props {
  src: string;
  alt: string;
  sizes: string;
  widths?: number[];
  class?: string;
  priority?: boolean;
}

const { src, widths = [320, 480, 768, 1024], ...attributes } = Astro.props;
const image = imageAsset(src);
const width = Math.min(image.width, Math.max(...widths));
---

<Image
  src={image}
  width={width}
  widths={widths}
  format="webp"
  {...attributes}
/>
