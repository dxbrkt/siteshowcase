---
import ResponsiveImage from './ResponsiveImage.astro';
import { imageAsset } from '../lib/images';
import { REVIEWS } from '../data/reviews';
import { withBase } from '../lib/urls';
import '../styles/client-stories.css';
---

<section class="client-stories" aria-labelledby="stories-heading">
  <div class="client-stories__inner">
    <div class="client-stories__heading">
      <h2 id="stories-heading">Отзывы клиентов</h2>
      <p>Из благодарственных писем наших заказчиков.</p>
    </div>
  </div>
  <div class="client-stories__grid">
    {
      REVIEWS.slice(0, 3).map((review) => (
        <>
          <article class="client-story">
            <blockquote>{review.quote}</blockquote>
            <div class="client-story__author">
              {review.logo ? (
                <>
                  <span class="client-story__brand">
                    <img
                      src={withBase(review.logo)}
                      alt={`Логотип ${review.org}`}
                      loading="lazy"
                    />
                  </span>
                </>
              ) : (
                <>
                  <span class="client-story__monogram" aria-hidden="true">
                    {review.initial}
                  </span>
                </>
              )}
              <div>
                <>
                  <h3>{review.org}</h3>
                  <p>{review.role}</p>
                </>
              </div>
            </div>
            <a
              class="client-story__document js-lightbox-item"
              href={imageAsset(review.src).src}
              data-src={imageAsset(review.src).src}
              data-caption={`${review.org} — благодарственное письмо`}
              aria-label={`Читать письмо: ${review.org}`}
            >
              <span class="client-story__paper">
                <ResponsiveImage
                  src={review.src}
                  alt=""
                  sizes="30px"
                  widths={[32, 64, 96]}
                />
              </span>
              <>
                <span>
                  Благодарственное письмо<small>Посмотреть оригинал</small>
                </span>
                <span class="client-story__arrow" aria-hidden="true">
                  ↗︎
                </span>
              </>
            </a>
          </article>
        </>
      ))
    }
  </div>
  <div class="client-stories__bottom">
    <a href={withBase('/otzyvy/')}
      >Все письма клиентов <span aria-hidden="true">↗︎</span></a
    >
  </div>
</section>
