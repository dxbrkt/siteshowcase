---
import '../styles/lightbox.css';
---

<dialog class="lightbox" id="lightbox" aria-label="Просмотр изображения">
  <button
    type="button"
    class="lightbox__close"
    id="lightboxClose"
    autofocus
    aria-label="Закрыть">&times;</button
  >
  <button
    type="button"
    class="lightbox__nav lightbox__prev"
    id="lightboxPrev"
    aria-label="Назад">&#8592;</button
  >
  <figure class="lightbox__figure">
    <img alt="" id="lightboxImg" class="lightbox__img" />
    <figcaption id="lightboxCaption" class="lightbox__caption"></figcaption>
  </figure>
  <button
    type="button"
    class="lightbox__nav lightbox__next"
    id="lightboxNext"
    aria-label="Вперёд">&#8594;</button
  >
</dialog>

<script>
  import { initLightbox } from '../scripts/lightbox';
  initLightbox();
</script>
