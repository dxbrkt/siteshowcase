---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
---

<BaseLayout
  title="Страница не найдена | Классика-АГ"
  description="Страница не найдена. Перейдите к услугам или свяжитесь с нами."
  activeNav=""
  noindex
>
  <section class="page-header">
    <div class="page-header__inner">
      <h1 class="page-header__title">Страница не найдена</h1>
      <p class="page-header__subtitle">
        Проверьте адрес или выберите нужный раздел.
      </p>
    </div>
  </section>
  <section class="clean-section">
    <div class="clean-section__inner">
      <nav class="service-detail__actions" aria-label="Разделы сайта">
        <a class="button button--cta" href={withBase('/')}>Главная</a>
        <a class="button button--outline" href={withBase('/uslugi/')}>Услуги</a>
        <a class="button button--outline" href={withBase('/kontakty/')}
          >Контакты</a
        >
      </nav>
    </div>
  </section>
</BaseLayout>
