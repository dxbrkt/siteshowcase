---
import ResponsiveImage from '../components/ResponsiveImage.astro';
import { fullWidthImageWidths } from '../lib/images';
import Lightbox from '../components/Lightbox.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import FinalCta from '../components/FinalCta.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { SERVICES } from '../data/services';
import ClientStories from '../components/ClientStories.astro';
import { office } from '../data/office';

const organization = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'ООО «Классика-АГ»',
  url: Astro.site && new URL(withBase('/'), Astro.site).href,
  telephone: '+7 495 933-74-96',
  email: 'info@classicag.ru',
  taxID: '7729687715',
  address: {
    '@type': 'PostalAddress',
    addressCountry: 'RU',
    addressLocality: office.city,
    postalCode: office.postalCode,
    streetAddress: office.street,
  },
};
const featuredServices = [
  SERVICES[0], // uborka-ofisov
  SERVICES[1], // uborka-pomeshenij
  SERVICES[2], // uhod-za-polami
  SERVICES[3], // mojka-okon-i-fasadov
  SERVICES[4], // vysotnye-raboty
  SERVICES[5], // uborka-posle-remonta
  SERVICES[6], // uborka-territorii
  SERVICES[9], // gryazezashchitnye-kovry
  SERVICES[10], // uborka-kvartir
];
---

<BaseLayout
  title={'Классика-АГ | Профессиональные клининговые услуги в Москве'}
  description={'Профессиональная уборка офисов, бизнес-центров, торговых комплексов, производственных объектов, квартир и коттеджей в Москве и Московской области.'}
  activeNav={'home'}
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(organization)}
  />
  <section class="hero">
    <div class="hero__image-wrap">
      <ResponsiveImage
        src="hero-classicag.jpg"
        alt="Специалист Классика-АГ за работой в офисе"
        class="hero__image"
        widths={fullWidthImageWidths}
        sizes="100vw"
        priority
      />
      <div class="hero__overlay"></div>
    </div>
    <div class="hero__content">
      <h1 class="hero__heading">
        <span>ЭФФЕКТИВНАЯ РАБОТА,</span><span>ЭФФЕКТИВНЫЙ КЛИНИНГ —</span><span
          class="hero__motto-result">УСПЕХ.</span
        >
      </h1>
      <p class="hero__sub">
        Уборка офисов, обслуживание зданий и уход за территориями в Москве и
        области. Согласуем состав работ и график под ваш объект.
      </p>
      <a class="button button--white-lg" href={withBase('/kontakty/#estimate')}>
        <span class="button__label">Рассчитать стоимость</span>
      </a>
      <div class="hero__details">
        <span>Москва и Московская область</span><a
          href={withBase('/sertifikaty/')}>Сертификаты компании ↗︎</a
        >
      </div>
    </div>
  </section>

  <section class="services-grid">
    <div class="services-grid__inner">
      <div class="fade-up">
        <div class="services-grid__header">
          <ResponsiveImage
            src="works/work-09.jpg"
            sizes="(max-width: 1240px) calc(100vw - 40px), 1200px"
            widths={fullWidthImageWidths}
            alt="Обслуживание коммерческой недвижимости"
            class="services-grid__header-img"
          />
          <div class="services-grid__header-overlay"></div>
          <div class="services-grid__header-content">
            <div>
              <h2 class="services-grid__heading">Наши услуги</h2>
              <p class="services-grid__sub">
                Ежедневная уборка, уход за каменными полами, мойка фасадов,
                промальп, послестроительный клининг и обслуживание зданий по
                индивидуальному графику.
              </p>
            </div>
            <a class="services-grid__all-link" href={withBase('/uslugi/')}
              >Все 12 направлений &rarr;</a
            >
          </div>
        </div>
      </div>

      <div class="services-grid__cards">
        {featuredServices.map((service) => <ServiceCard service={service} />)}
      </div>
    </div>
  </section>

  <ClientStories />

  <FinalCta photoSrc={'works/work-04.jpg'} />
  <Lightbox />
</BaseLayout>
