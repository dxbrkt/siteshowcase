---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { SERVICES } from '../data/services';
import { office, officeMapUrl, officeMapEmbedUrl } from '../data/office';
---

<BaseLayout
  title={'Контакты | Классика-АГ'}
  description={`Контакты клининговой компании ООО «Классика-АГ»: +7 (495) 933-74-96, info@classicag.ru, ${office.city}, ${office.street}.`}
  activeNav={'kontakty'}
>
  <div class="page-header">
    <div class="page-header__inner">
      <h1 class="page-header__title">Свяжитесь с нами</h1>
      <p class="page-header__subtitle">
        Оставьте запрос на бесплатный расчёт стоимости уборки или задайте любой
        вопрос по обслуживанию вашего объекта.
      </p>
    </div>
  </div>

  <section class="contact-page" id="estimate">
    <div class="contact-page__inner">
      <div class="fade-up contact-page__form-wrap">
        <h2 class="contact-page__form-title">
          Запрос расчёта и обратная связь
        </h2>
        <form class="contact-form js-lead-form" novalidate>
          <div class="contact-form__row">
            <div class="contact-form__field">
              <label for="name">Ваше имя или организация</label>
              <input
                id="name"
                name="name"
                type="text"
                placeholder="Иван Петров / ООО «Компания»"
                required
                autocomplete="name"
              />
            </div>
            <div class="contact-form__field">
              <label for="email">Электронная почта</label>
              <input
                id="email"
                name="email"
                type="email"
                placeholder="name@company.ru"
                autocomplete="email"
              />
            </div>
          </div>

          <div class="contact-form__row">
            <div class="contact-form__field">
              <label for="phone">Номер телефона</label>
              <input
                id="phone"
                name="phone"
                type="tel"
                class="js-phone-input"
                placeholder="+7 (___) ___-__-__"
                required
                autocomplete="tel"
              />
            </div>
            <div class="contact-form__field">
              <label for="service">Меня интересует</label>
              <select id="service" name="service">
                <option value="free-estimate">Расчёт стоимости уборки</option>
                {
                  SERVICES.map((s) => (
                    <>
                      <option value={s.slug}>{s.title}</option>
                    </>
                  ))
                }
                <option value="tender">Приглашение в тендер</option>
                <option value="employment">Трудоустройство / вакансии</option>
              </select>
            </div>
          </div>

          <div class="contact-form__field">
            <label for="comment">Опишите ваш объект и задачу</label>
            <textarea
              id="comment"
              name="comment"
              rows="5"
              placeholder="Укажите ориентировочную площадь в м², адрес в Москве/МО и желаемый график работ…"
            ></textarea>
          </div>

          <div>
            <button class="button button--cta-lg" type="submit">
              <span class="button__label">Подготовить письмо</span>
            </button>
          </div>

          <p class="contact-form__disclaimer">
            Форма подготовит письмо в вашей почтовой программе. Проверьте его и
            отправьте на info@classicag.ru. Данные не отправляются
            автоматически.
          </p>
          <div class="form-msg" aria-live="polite"></div>
        </form>
      </div>

      <aside class="fade-up contact-sidebar">
        <div class="contact-sidebar__item">
          <span class="contact-sidebar__icon"
            ><span class="svg-icon"><Icon name="phone" /></span></span
          >
          <div>
            <strong>Телефон</strong>
            <a href="tel:+74959337496">+7 (495) 933-74-96</a>
          </div>
        </div>

        <div class="contact-sidebar__item">
          <span class="contact-sidebar__icon"
            ><span class="svg-icon"><Icon name="mail" /></span></span
          >
          <div>
            <strong>Электронная почта</strong>
            <a href="mailto:info@classicag.ru">info@classicag.ru</a>
          </div>
        </div>

        <div class="contact-sidebar__item">
          <span class="contact-sidebar__icon"
            ><span class="svg-icon"><Icon name="pin" /></span></span
          >
          <div>
            <strong>Адрес офиса</strong>
            <span>
              {office.postalCode}, {office.city}, {office.street}<br />{
                office.building
              }
            </span>
          </div>
        </div>

        <div class="contact-sidebar__item">
          <span class="contact-sidebar__icon"
            ><span class="svg-icon"><Icon name="clock" /></span></span
          >
          <div>
            <strong>Режим работы</strong>
            <span
              >Офис: Пн–Пт 09:00–18:00<br />Выезд клининговых бригад: 24/7</span
            >
          </div>
        </div>

        <div class="contact-sidebar__item">
          <span class="contact-sidebar__icon"
            ><span class="svg-icon"><Icon name="shield" /></span></span
          >
          <div>
            <strong>Реквизиты</strong>
            <span
              >ООО «Классика-АГ» · ИНН 7729687715<br />Контактный телефон: +7
              (495) 933-74-96</span
            >
          </div>
        </div>

        <div class="office-map">
          <iframe
            src={officeMapEmbedUrl}
            title={`Карта проезда: ${office.city}, ${office.street}`}
            loading="lazy"></iframe>
          <a href={officeMapUrl} target="_blank" rel="noopener noreferrer">
            Открыть в Яндекс Картах <span aria-hidden="true">↗</span>
          </a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .office-map {
    display: grid;
    gap: 8px;
  }

  .office-map iframe {
    display: block;
    width: 100%;
    height: clamp(240px, 30vw, 320px);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-bg-alt);
  }

  .office-map a {
    justify-self: start;
    padding-block: 8px;
    font-size: 14px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>

<script>
  import { initContactForm } from '../scripts/contact-form';
  initContactForm();
</script>
