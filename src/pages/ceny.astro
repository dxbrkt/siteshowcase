---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../lib/urls';
import FinalCta from '../components/FinalCta.astro';
import { SERVICES } from '../data/services';
import { CALCULATOR_ITEMS } from '../data/pricing';
import { MAT_RENTAL_SIZES } from '../data/pricing';
const groups = [...new Set(CALCULATOR_ITEMS.map((i) => i.group))];
---

<BaseLayout
  title={'Цены на клининг и калькулятор стоимости | Классика-АГ'}
  description={'Прайс-лист и онлайн-калькулятор клининговой компании ООО «Классика-АГ»: уборка офисов, БЦ, ТЦ, мытьё окон, уход за полами, квартиры, коттеджи и ковры.'}
  activeNav={'ceny'}
>
  <div class="page-header">
    <div class="page-header__inner">
      <h1 class="page-header__title">Цены и калькулятор сметы</h1>
      <p class="page-header__subtitle">
        Рассчитайте ориентировочный бюджет уборки онлайн или ознакомьтесь с
        базовым прайс-листом ООО «Классика-АГ» по всем видам работ.
      </p>
    </div>
  </div>

  <section class="clean-section clean-section--alt" id="calculator">
    <div class="clean-section__inner">
      <div class="calc-grid fade-up">
        <div class="calc-panel">
          <div>
            <h2 class="section-heading" style="font-size:24px;">
              Расчёт стоимости услуг
            </h2>
            <p class="section-sub" style="margin-top:6px;">
              Выберите один или несколько видов работ, чтобы собрать
              предварительную смету.
            </p>
          </div>

          <div class="contact-form__field">
            <label for="calcServiceSelect">Вид работ</label>
            <select id="calcServiceSelect">
              {
                groups.map((g) => (
                  <>
                    <optgroup label={g}>
                      {CALCULATOR_ITEMS.filter((it) => it.group === g).map(
                        (it) => (
                          <>
                            <option
                              value={it.id}
                              data-price={it.price}
                              data-unit={it.unit}
                            >
                              {it.name} — {it.priceText} / {it.unit}
                            </option>
                          </>
                        ),
                      )}
                    </optgroup>
                  </>
                ))
              }
            </select>
          </div>

          <div class="calc-fields-row">
            <div class="contact-form__field">
              <label for="calcQtyInput"
                >Объём (<span id="calcUnitLabel">м²</span>)</label
              >
              <input
                type="number"
                id="calcQtyInput"
                value="250"
                min="1"
                max="500000"
              />
            </div>
            <div class="contact-form__field">
              <label for="calcFreqSelect">Периодичность</label>
              <select id="calcFreqSelect">
                <option value="1">Разовый заказ</option>
                <option value="4">1 раз в неделю (4 выезда / мес.)</option>
                <option value="22">По будням (22 смены / мес.)</option>
                <option value="30">Ежедневно (30 смен / мес.)</option>
              </select>
            </div>
          </div>

          <div class="calc-bar">
            <span class="calc-bar__sum"
              >Сумма позиции: <strong id="calcPreviewSum">8 750 ₽</strong></span
            >
            <button type="button" class="button button--cta" id="calcAddBtn">
              <span class="button__label">Добавить в смету</span>
            </button>
          </div>

          <div class="calc-divider"></div>

          <div>
            <h3 style="font-size:18px;margin-bottom:4px;">
              Аренда сменных грязезащитных ковров
            </h3>
            <p style="font-size:14px;color:var(--color-body);">
              Расчёт сервиса регулярной замены ковров на 4 недели.
            </p>
          </div>

          <div class="calc-fields-row">
            <div class="contact-form__field">
              <label for="matSizeSelect">Размер ковра</label>
              <select id="matSizeSelect">
                {
                  MAT_RENTAL_SIZES.map((m) => (
                    <>
                      <option value={m.pricePerSwap} data-size={m.size}>
                        {m.size} ({m.pricePerSwap} ₽)
                      </option>
                    </>
                  ))
                }
              </select>
            </div>
            <div class="contact-form__field">
              <label for="matCountInput">Количество, шт.</label>
              <input
                type="number"
                id="matCountInput"
                value="2"
                min="1"
                max="200"
              />
            </div>
            <div class="contact-form__field">
              <label for="matSwapsSelect">Замен в неделю</label>
              <select id="matSwapsSelect">
                <option value="1">1 раз в неделю</option>
                <option value="2" selected>2 раза в неделю</option>
                <option value="3">3 раза в неделю</option>
                <option value="5">5 раз в неделю</option>
              </select>
            </div>
          </div>

          <div class="calc-bar">
            <span class="calc-bar__sum"
              >В месяц: <strong id="matPreviewSum">9 180 ₽</strong></span
            >
            <button type="button" class="button button--outline" id="matAddBtn">
              <span class="button__label">Добавить ковры</span>
            </button>
          </div>
        </div>

        <aside class="calc-panel calc-panel--sticky">
          <div
            style="display:flex;justify-content:space-between;align-items:baseline;"
          >
            <h3 style="font-size:20px;">Предварительная смета</h3>
            <button
              type="button"
              id="calcClearBtn"
              style="background:none;border:none;font-size:13px;color:var(--color-body);cursor:pointer;text-decoration:underline;"
              >Очистить</button
            >
          </div>

          <div class="basket-list" id="calcBasketItems"></div>

          <div class="basket-totals">
            <div class="basket-totals__line">
              <span>Базовый расчёт</span>
              <span id="calcSubtotal">0 ₽</span>
            </div>

            <div class="basket-totals__line basket-totals__line--grand">
              <span>Итого ориентировочно</span>
              <span id="calcGrandTotal">0 ₽</span>
            </div>
          </div>

          <a
            class="button button--cta-lg"
            href={withBase('/kontakty/#estimate')}
            id="sendEstimateLink"
            style="width:100%;"
          >
            <span class="button__label">Отправить расчёт менеджеру</span>
          </a>
          <p style="font-size:12.5px;color:var(--color-body);line-height:1.55;">
            Расчёт предварительный. Итоговую стоимость уточняйте у специалиста
            компании.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="clean-section">
    <div class="clean-section__inner">
      <div class="clean-section__head fade-up">
        <div>
          <h2 class="section-heading">Прайс-лист по направлениям</h2>
          <p class="section-sub">
            Базовые расценки, опубликованные на оригинальном сайте. Актуальную
            стоимость уточняйте у специалиста.
          </p>
        </div>
      </div>

      {
        SERVICES.map((s) => (
          <>
            <div
              class="fade-up"
              style="display:flex;flex-direction:column;gap:14px;"
            >
              <div style="display:flex;justify-content:space-between;align-items:baseline;gap:16px;flex-wrap:wrap;">
                <h3 style="font-size:21px;">
                  <a
                    href={withBase(`/uslugi/${s.slug}/`)}
                    style="color:var(--color-heading);"
                  >
                    {s.title}
                  </a>
                </h3>
                <a class="clean-link" href={withBase(`/uslugi/${s.slug}/`)}>
                  Описание услуги &rarr;
                </a>
              </div>
              <div class="clean-table-wrap">
                <table class="clean-table">
                  <thead>
                    <tr>
                      <th>Наименование работ</th>
                      <th>Ед. изм.</th>
                      <th>Тариф</th>
                    </tr>
                  </thead>
                  <tbody>
                    {s.prices.map((r) => (
                      <>
                        <tr>
                          <td>{r[0]}</td>
                          <td>{r[1]}</td>
                          <td class="clean-table__price">{r[2]}</td>
                        </tr>
                      </>
                    ))}
                  </tbody>
                </table>
              </div>
            </div>
          </>
        ))
      }
    </div>
  </section>

  <FinalCta photoSrc={'/assets/images/works/work-11.jpg'} />
</BaseLayout>

<script>
  import { initCalculator } from '../scripts/calculator';
  initCalculator();
</script>
