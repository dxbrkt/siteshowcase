---
import BaseLayout from '../layouts/BaseLayout.astro';
import FinalCta from '../components/FinalCta.astro';
import PriceCatalog from '../components/PriceCatalog.astro';
import EstimateCalculator from '../components/EstimateCalculator.astro';
import '../styles/calculator.css';
---

<BaseLayout
  title="Цены на клининг и калькулятор стоимости | Классика-АГ"
  description="Прайс-лист и онлайн-калькулятор клининговой компании ООО «Классика-АГ»: уборка офисов, БЦ, ТЦ, мытьё окон, уход за полами, квартиры, коттеджи и ковры."
  activeNav="ceny"
>
  <div class="prices-intro">
    <div class="prices-shell prices-intro__inner">
      <h1>Цены на клининг</h1>
      <nav class="prices-jump" aria-label="На странице">
        <a href="#prices">Прайс-лист</a>
        <a href="#calculator"
          >Рассчитать смету <span aria-hidden="true">↓</span></a
        >
      </nav>
    </div>
  </div>

  <PriceCatalog />
  <EstimateCalculator />
  <FinalCta photoSrc="works/work-11.jpg" />
</BaseLayout>
